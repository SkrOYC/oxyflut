{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:ci-invocation:1",
  "title": "Oxyflut build invocation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "builderId",
    "environment",
    "sourceCommit",
    "lockDigest",
    "command",
    "startedAt",
    "finishedAt",
    "materials",
    "outputs"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "builderId": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "sourceCommit": { "$ref": "#/$defs/sha40" },
    "lockDigest": { "$ref": "#/$defs/sha256" },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "materials": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "minItems": 1
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "minItems": 1
    }
  },
  "$defs": {
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
