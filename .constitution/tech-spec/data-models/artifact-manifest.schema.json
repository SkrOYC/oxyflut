{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:artifact-manifest:4",
  "title": "Oxyflut canonical artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "environment",
    "source",
    "qualificationLockDigest",
    "externalContractLockDigest",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0.0" },
    "candidate": { "enum": ["focused", "integrated"] },
    "environment": {
      "enum": [
        "macos-arm64",
        "windows-x86_64",
        "wayland-linux-x86_64",
        "x11-linux-x86_64"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oxyflutCommit",
        "flutterFrameworkCommit",
        "flutterEngineCommit",
        "candidateCommit",
        "adapterCommit"
      ],
      "properties": {
        "oxyflutCommit": { "$ref": "#/$defs/sha40" },
        "flutterFrameworkCommit": { "$ref": "#/$defs/sha40" },
        "flutterEngineCommit": { "$ref": "#/$defs/sha40" },
        "candidateCommit": { "$ref": "#/$defs/sha40" },
        "adapterCommit": { "$ref": "#/$defs/sha40" }
      }
    },
    "qualificationLockDigest": { "$ref": "#/$defs/sha256" },
    "externalContractLockDigest": { "$ref": "#/$defs/sha256" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "mode", "size", "sha256", "licenseIds"],
        "properties": {
          "path": { "$ref": "#/$defs/artifactPath" },
          "kind": { "enum": ["file", "symlink", "hardlink"] },
          "mode": { "type": "integer", "minimum": 0, "maximum": 4095 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "linkTarget": { "$ref": "#/$defs/artifactPath" },
          "licenseIds": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "kind": { "enum": ["symlink", "hardlink"] } },
              "required": ["kind"]
            },
            "then": { "required": ["linkTarget"] },
            "else": { "properties": { "linkTarget": false } }
          }
        ]
      }
    }
  },
  "$defs": {
    "artifactPath": {
      "type": "string",
      "pattern": "^(?![A-Za-z]:)(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(?!(?:\\.{1,2})(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sha40": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
