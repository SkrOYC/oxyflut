{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:platform-contracts:5",
  "title": "Oxyflut platform qualification contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "specificationVersion",
    "environments",
    "absentEvents"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "5.0.0" },
    "specificationVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "environments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macos", "windows", "wayland", "x11"],
      "properties": {
        "macos": { "$ref": "#/$defs/environment" },
        "windows": { "$ref": "#/$defs/environment" },
        "wayland": { "$ref": "#/$defs/environment" },
        "x11": { "$ref": "#/$defs/environment" }
      }
    },
    "absentEvents": {
      "type": "array",
      "items": { "$ref": "#/$defs/absentEvent" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidenceSet": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence" },
      "uniqueItems": true
    },
    "status": { "enum": ["kk", "ku-gating"] },
    "absentEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "gateId",
        "eventId",
        "status",
        "environments",
        "candidates",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ABS-[A-Z0-9]+-[0-9]{3}$"
        },
        "gateId": {
          "type": "string",
          "pattern": "^(?:CAP|CON)-[A-Z0-9]+-[0-9]{3}$"
        },
        "eventId": { "type": "string", "minLength": 1 },
        "status": { "const": "absent-kk" },
        "environments": {
          "type": "array",
          "items": { "enum": ["macos", "windows", "wayland", "x11"] },
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": { "enum": ["focused", "integrated"] },
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "stringSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "openQuestionSet": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "contractRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "sha256"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "path": { "type": ["string", "null"], "minLength": 1 },
        "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "kk" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            }
          },
          "else": {
            "properties": {
              "path": { "type": "null" },
              "sha256": { "type": "null" }
            }
          }
        }
      ]
    },
    "ime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "nativeIndexUnit",
        "engineIndexUnit",
        "metadata",
        "actions",
        "sensitiveFieldPolicy",
        "numericNegotiation",
        "testVectors",
        "evidence"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "nativeIndexUnit": {
          "enum": ["utf8-bytes", "utf16-code-units", "unicode-scalars"]
        },
        "engineIndexUnit": {
          "const": "checked-logical-with-explicit-conversion"
        },
        "metadata": { "$ref": "#/$defs/stringSet" },
        "actions": { "$ref": "#/$defs/stringSet" },
        "sensitiveFieldPolicy": { "type": "string", "minLength": 1 },
        "numericNegotiation": { "type": "string", "minLength": 1 },
        "testVectors": { "$ref": "#/$defs/stringSet" },
        "evidence": { "$ref": "#/$defs/evidenceSet" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "kk" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "interactiveOpportunitySource",
        "independentMeterSource",
        "presentationFeedback",
        "perDisplayAssociation",
        "evidence"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "interactiveOpportunitySource": { "type": "string", "minLength": 1 },
        "independentMeterSource": { "type": "string", "minLength": 1 },
        "presentationFeedback": { "type": "string", "minLength": 1 },
        "perDisplayAssociation": { "type": "string", "minLength": 1 },
        "evidence": { "$ref": "#/$defs/evidenceSet" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "kk" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "windowAndInput",
        "imeInterfaces",
        "accessibilityInterfaces",
        "clipboardInterfaces",
        "timingInterfaces",
        "recoveryInterfaces",
        "serviceRouting",
        "normalization",
        "requiredEvidence",
        "evidence"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "windowAndInput": { "$ref": "#/$defs/stringSet" },
        "imeInterfaces": { "$ref": "#/$defs/stringSet" },
        "accessibilityInterfaces": { "$ref": "#/$defs/stringSet" },
        "clipboardInterfaces": { "$ref": "#/$defs/stringSet" },
        "timingInterfaces": { "$ref": "#/$defs/stringSet" },
        "recoveryInterfaces": { "$ref": "#/$defs/stringSet" },
        "serviceRouting": { "type": "string", "minLength": 1 },
        "normalization": { "type": "string", "minLength": 1 },
        "requiredEvidence": { "$ref": "#/$defs/stringSet" },
        "evidence": { "$ref": "#/$defs/evidenceSet" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "kk" } },
            "required": ["status"]
          },
          "then": {
            "properties": { "evidence": { "type": "array", "minItems": 1 } }
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reference",
        "minimumVersion",
        "protocols",
        "ime",
        "accessibilityMaps",
        "timing",
        "recoveryBaseline",
        "allocations",
        "openQuestions"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "reference": { "type": "string", "minLength": 1 },
        "minimumVersion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value", "evidence"],
          "properties": {
            "status": { "$ref": "#/$defs/status" },
            "value": { "type": ["string", "null"] },
            "evidence": { "$ref": "#/$defs/evidenceSet" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "status": { "const": "kk" } },
                "required": ["status"]
              },
              "then": {
                "properties": {
                  "value": { "type": "string", "minLength": 1 },
                  "evidence": { "type": "array", "minItems": 1 }
                }
              },
              "else": { "properties": { "value": { "type": "null" } } }
            }
          ]
        },
        "protocols": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version", "status", "evidence"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": ["string", "null"] },
              "status": { "$ref": "#/$defs/status" },
              "evidence": { "$ref": "#/$defs/evidenceSet" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "kk" } },
                  "required": ["status"]
                },
                "then": {
                  "properties": {
                    "version": { "type": "string", "minLength": 1 },
                    "evidence": { "type": "array", "minItems": 1 }
                  }
                },
                "else": { "properties": { "version": { "type": "null" } } }
              }
            ]
          },
          "minItems": 1
        },
        "ime": { "$ref": "#/$defs/ime" },
        "accessibilityMaps": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focused", "integrated"],
          "properties": {
            "focused": { "$ref": "#/$defs/contractRef" },
            "integrated": { "$ref": "#/$defs/contractRef" }
          }
        },
        "timing": { "$ref": "#/$defs/timing" },
        "recoveryBaseline": { "$ref": "#/$defs/contractRef" },
        "allocations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["focused", "integrated"],
          "properties": {
            "focused": { "$ref": "#/$defs/allocation" },
            "integrated": { "$ref": "#/$defs/allocation" }
          }
        },
        "openQuestions": { "$ref": "#/$defs/openQuestionSet" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "kk" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "openQuestions": { "type": "array", "maxItems": 0 },
              "minimumVersion": {
                "type": "object",
                "properties": { "status": { "const": "kk" } }
              },
              "protocols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": { "status": { "const": "kk" } }
                }
              },
              "ime": {
                "type": "object",
                "properties": { "status": { "const": "kk" } }
              },
              "timing": {
                "type": "object",
                "properties": { "status": { "const": "kk" } }
              },
              "recoveryBaseline": {
                "type": "object",
                "properties": { "status": { "const": "kk" } }
              },
              "accessibilityMaps": {
                "type": "object",
                "properties": {
                  "focused": {
                    "type": "object",
                    "properties": { "status": { "const": "kk" } }
                  },
                  "integrated": {
                    "type": "object",
                    "properties": { "status": { "const": "kk" } }
                  }
                }
              },
              "allocations": {
                "type": "object",
                "properties": {
                  "focused": {
                    "type": "object",
                    "properties": { "status": { "const": "kk" } }
                  },
                  "integrated": {
                    "type": "object",
                    "properties": { "status": { "const": "kk" } }
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "openQuestions": { "type": "array", "minItems": 1 }
            }
          }
        }
      ]
    }
  }
}
