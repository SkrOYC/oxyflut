{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:external-in-toto-statement-v1:1",
  "title": "Oxyflut derived in-toto Statement v1 structural schema",
  "type": "object",
  "required": ["_type", "subject", "predicateType"],
  "properties": {
    "_type": { "const": "https://in-toto.io/Statement/v1" },
    "subject": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest"],
        "properties": {
          "name": { "type": "string" },
          "digest": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "predicateType": { "type": "string", "minLength": 1 },
    "predicate": { "type": "object" }
  }
}
