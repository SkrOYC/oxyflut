{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:external-spdx-3.0.1:1",
  "title": "Oxyflut derived SPDX 3.0.1 JSON-LD document structural schema",
  "type": "object",
  "required": ["@context", "spdxId"],
  "properties": {
    "@context": { "const": "https://spdx.org/rdf/3.0.1/spdx-context.jsonld" },
    "spdxId": { "type": "string", "minLength": 1 }
  },
  "anyOf": [
    { "required": ["type"], "properties": { "type": { "const": "SpdxDocument" } } },
    { "required": ["@type"], "properties": { "@type": { "const": "SpdxDocument" } } }
  ]
}
