{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oxyflut:schema:external-dsse-envelope-v1:1",
  "title": "Oxyflut derived DSSE Envelope v1 structural schema",
  "type": "object",
  "required": ["payload", "payloadType", "signatures"],
  "properties": {
    "payload": { "type": "string" },
    "payloadType": { "type": "string" },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sig"],
        "properties": {
          "keyid": { "type": "string" },
          "sig": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
