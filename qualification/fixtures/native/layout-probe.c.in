#include <stddef.h>
#include <stdio.h>

#include "oxyflut-substrate.h"

static int first_struct = 1;
static int first_field = 1;

static void begin_struct(const char *name, size_t size, size_t alignment) {
  if (!first_struct) {
    putchar(',');
  }
  first_struct = 0;
  first_field = 1;
  printf("{\"name\":\"%s\",\"size\":%zu,\"align\":%zu,\"fields\":[", name, size, alignment);
}

static void emit_field(const char *name, size_t offset, const char *nullability) {
  if (!first_field) {
    putchar(',');
  }
  first_field = 0;
  printf("{\"name\":\"%s\",\"offset\":%zu,\"nullability\":\"%s\"}", name, offset, nullability);
}

static void end_struct(void) {
  fputs("]}", stdout);
}

#define BEGIN_STRUCT(type) begin_struct(#type, sizeof(type), _Alignof(type))
#define FIELD(type, member, nullability) emit_field(#member, offsetof(type, member), nullability)

int main(void) {
